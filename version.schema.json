{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "git"
  ],
  "properties": {
    "git": {
      "type": "object",
      "required": [
        "platform",
        "url"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "github",
            "github-enterprise",
            "bitbucket",
            "bitbucket-server",
            "gitlab",
            "azure-devops"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "apiUrl": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "remote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "auth": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "enum": [
                "token",
                "bearer"
              ],
              "default": "token"
            }
          },
          "additionalProperties": false
        },
        "api": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000,
              "default": 30000
            }
          },
          "additionalProperties": false
        },
        "branchType": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "pr": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reviewers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "draft": {
              "type": "boolean",
              "default": false
            },
            "template": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "milestone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "linkedIssues": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limits": {
          "type": "object",
          "properties": {
            "branchMaxCommentLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        },
        "commit": {
          "type": "object",
          "properties": {
            "message": {
              "type": "object",
              "properties": {
                "semver": {
                  "type": "object",
                  "properties": {
                    "patch": {
                      "type": "string"
                    },
                    "prepatch": {
                      "type": "string"
                    },
                    "minor": {
                      "type": "string"
                    },
                    "preminor": {
                      "type": "string"
                    },
                    "premajor": {
                      "type": "string"
                    },
                    "major": {
                      "type": "string"
                    },
                    "prerelease": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "branching": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "default",
                "trunk-based",
                "git-flow",
                "release-branch",
                "hotfix",
                "maintenance"
              ],
              "default": "default"
            },
            "branchTemplate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "tagTemplate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mainBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "default": "master"
            },
            "developBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "default": "develop"
            }
          },
          "additionalProperties": false
        }
      },
      "if": {
        "properties": {
          "platform": {
            "enum": [
              "github-enterprise",
              "bitbucket-server"
            ]
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "required": [
          "apiUrl"
        ]
      }
    }
  },
  "additionalProperties": false
}