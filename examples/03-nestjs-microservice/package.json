  },
  "dependencies": {
    "@nestjs/core": "^10.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "versionings": "^1.0.0"
  }
}