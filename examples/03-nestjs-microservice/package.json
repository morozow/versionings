{
  "name": "03-nestjs-microservice",
  "version": "1.0.0",
  "description": "NestJS microservice — git-flow workflow with GitLab MR automation",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
